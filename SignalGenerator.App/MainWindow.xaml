<Window x:Class="SignalGenerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:SignalGenerator.App"
        mc:Ignorable="d"
        Title="SignalParser" Height="450" Width="800" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        
        <ScottPlot:WpfPlot x:Name="WpfPlot1" Grid.Column="0" />
        <DockPanel Grid.Column="1" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Длина (с):" Margin="10,10,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="SignalLengthTextBox" Margin="0,10,0,0" Text="20" Height="20" Width="30"/>
                <Label Content="Частота (Гц):" Margin="10,10,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="SignalFrequencyTextBox" Margin="0,10,0,0" Text="200" Height="20" Width="30"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="SinButton"
                        Content="Sin"
                        Width="50"
                        HorizontalAlignment="Center"
                        Margin="10,10,0,0"
                        VerticalAlignment="Center"
                        Click="SinButton_Click"/>
                <Label Content="Период (с):" Margin="10,10,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="SinPeriodTextBox" Margin="0,10,0,0" Text="1" Height="20" Width="30"/>
                <Label Content="Фаза (с):" Margin="10,10,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="SinPhaseTextBox" Margin="0,10,0,0" Text="0" Height="20" Width="30"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="LineButton"
                    Content="Прямая"
                    Width="50"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center" Click="LineButton_Click"/>
                <Label Content="k:" Margin="10,10,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="KTextBox" Margin="0,10,0,0" Text="1" Height="20" Width="30"/>
                <Label Content="b:" Margin="10,10,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="BTextBox" Margin="0,10,0,0" Text="2" Height="20" Width="30"/>
            </StackPanel>
            
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="NoiseButton"
                    Content="Шум"
                    Width="50"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center" Click="NoiseButton_Click"/>
                <Label Content="Амплитуда:" Margin="10,10,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="NoiseAmplitudeTextBox" Margin="0,10,0,0" Text="0.1" Height="20" Width="30"/>
            </StackPanel>
            
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button x:Name="ResetButton"
                    Content="Сброс"
                    Width="60"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center" Click="ResetButton_Click"/>
                <Button x:Name="DeleteButton"
                    Content="Удалить"
                    Width="60"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center" Click="DeleteButton_Click"/>
                <Button x:Name="LoadButton"
                    Content="Загрузить"
                    Width="60"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center" Click="LoadButton_Click"/>
                <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Width="60"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center" Click="SaveButton_Click"/>
            </StackPanel>
            
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button x:Name="SumButton"
                    Content="Сумма"
                    Width="60"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center" Click="SumButton_Click"/>
                <Button x:Name="ConcatButton"
                    Content="Склейка"
                    Width="60"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center" Click="ConcatButton_Click"/>
                <!--Button x:Name="DerivativeButton"
                    Content="Производная"
                    Width="60"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center" Click="DerivativeButton_Click"/-->
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button x:Name="OutOfRangeDetectionButton"
                    Content="Зашкалы"
                    Width="80"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center"/>
                <Label Content="Мин.:" Margin="10,0,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="MinTextBox" Text="-0.2" Height="20" Width="30"/>
                <Label Content="Макс.:" Margin="10,0,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="MaxTextBox" Text="0.8" Height="20" Width="30"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button x:Name="FilterOfflineButton"
                    Content="Фильтр офлайн"
                    Width="80"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center" Click="FilterOfflineButton_Click"/>
                <Label Content="Окно (с):" Margin="10,0,0,0" Height="20" Padding="5,0,5,5"/>
                <TextBox x:Name="FilterWindowSizeTextBox" Text="0.2" Height="20" Width="30"/>
                <Button x:Name="FilterOnlineButton"
                    Content="Фильтр онлайн"
                    Width="80"
                    HorizontalAlignment="Center"
                    Margin="10,10,0,10"
                    VerticalAlignment="Center" Click="FilterOnlineButton_Click"/>
            </StackPanel>

        </DockPanel>
    </Grid>
</Window>
